{
  "name": "@mipsel64/pi-pensieve",
  "version": "0.2.0",
  "description": "Pensieve short-term memory for Pi",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mipsel64/pi-pensieve.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.ts"
  ],
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "check": "tsc",
    "test": "node --import jiti/register --test test/*.test.ts",
    "prepublishOnly": "npm run check && npm test"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "@types/node": "^26.6.2",
    "jiti": "^2.7.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@aliou/pi-utils-settings": "^0.21.0"
  }
}
